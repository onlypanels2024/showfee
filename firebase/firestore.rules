rules_version = '2';
// ShowFee booking system – who may read and write what.
// pages/{slug}     public booking page of one ShowFee user (name, free days, busy dates – no client details)
// requests/{id}    booking requests sent from a booking page – only the page's owner can read them
// contracts/{id}   ShowFee Business contracts – opened and signed by the client through a private link
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function str(v, max) { return v is string && v.size() <= max; }
    function filled(v, max) { return str(v, max) && v.trim().size() > 0; }
    // A list of up to 6 short texts (the user's own booking questions, or a client's answers to them).
    function texts(l, max) {
      return l is list && l.size() <= 6
        && (l.size() < 1 || str(l[0], max)) && (l.size() < 2 || str(l[1], max))
        && (l.size() < 3 || str(l[2], max)) && (l.size() < 4 || str(l[3], max))
        && (l.size() < 5 || str(l[4], max)) && (l.size() < 6 || str(l[5], max));
    }

    match /pages/{slug} {
      // ShowFee Business branding: colour, light/dark page, "Powered by ShowFee" on/off, and a small logo image.
      function validBrand(b) {
        return b is map && b.keys().hasOnly(['color', 'theme', 'powered', 'logo'])
          && (!('color' in b) || (b.color is string && b.color.matches('^#[0-9a-fA-F]{6}$')))
          && (!('theme' in b) || b.theme in ['light', 'dark'])
          && (!('powered' in b) || b.powered is bool)
          && (!('logo' in b) || (b.logo is string && b.logo.size() <= 150000 && b.logo.matches('^data:image/(png|jpeg);base64,.*')));
      }
      function validPage(d) {
        return d.keys().hasOnly(['uid', 'name', 'tagline', 'accepting', 'days', 'busy', 'fields', 'brand', 'updated'])
          && (!('brand' in d) || validBrand(d.brand))
          && filled(d.name, 60)
          && str(d.get('tagline', ''), 80)
          && d.accepting is bool
          && d.days is list && d.days.size() <= 7
          && d.busy is list && d.busy.size() <= 400
          && texts(d.get('fields', []), 40)
          && d.updated == request.time;
      }

      // Anyone can open one page by its link, but nobody can list all pages.
      allow get: if true;
      // Anonymous accounts are only for ShowFee's automatic tests: they may only make "test-" pages.
      allow create: if signedIn()
        && slug.matches('^[a-z0-9][a-z0-9-]{1,30}$')
        && (request.auth.token.firebase.sign_in_provider != 'anonymous' || slug.matches('^test-[a-z0-9-]+$'))
        && request.resource.data.uid == request.auth.uid
        && validPage(request.resource.data);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && validPage(request.resource.data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /requests/{id} {
      // Anyone may send a request, but only a well-formed one, to a page that is taking requests.
      allow create: if request.resource.data.keys().hasOnly(
            ['slug', 'owner', 'date', 'name', 'contact', 'ask', 'answers', 'message', 'status', 'created'])
        && request.resource.data.keys().hasAll(['slug', 'owner', 'date', 'name', 'contact', 'status', 'created'])
        && str(request.resource.data.slug, 32)
        && exists(/databases/$(database)/documents/pages/$(request.resource.data.slug))
        && get(/databases/$(database)/documents/pages/$(request.resource.data.slug)).data.accepting == true
        && request.resource.data.owner == get(/databases/$(database)/documents/pages/$(request.resource.data.slug)).data.uid
        && request.resource.data.date is string
        && request.resource.data.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && filled(request.resource.data.name, 80)
        && filled(request.resource.data.contact, 120)
        // The questions must be exactly the ones on the page, with one answer each.
        && request.resource.data.get('ask', []) == get(/databases/$(database)/documents/pages/$(request.resource.data.slug)).data.get('fields', [])
        && texts(request.resource.data.get('answers', []), 200)
        && request.resource.data.get('answers', []).size() == request.resource.data.get('ask', []).size()
        && str(request.resource.data.get('message', ''), 500)
        && request.resource.data.status == 'new'
        && request.resource.data.created == request.time;
      // Only the ShowFee user the request was sent to can see it, answer it or delete it.
      allow read, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'accepted', 'declined'];
    }

    match /devices/{uid} {
      // The phones of one ShowFee user that get booking-request notifications. Only that user can see or change it.
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokens', 'updated'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 20
        && request.resource.data.updated == request.time;
    }

    match /contracts/{id} {
      // ShowFee Business contracts. The id is long and random: only people given the link can open one.
      // The ShowFee user signs it in the app and sends it; the client signs it once on showfee.app/sign.
      function sig(s) { return s is string && s.size() <= 120000 && s.matches('^data:image/png;base64,.*'); }

      allow get: if true;
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      // Anonymous accounts are only for ShowFee's automatic tests: they may only make "test-" contracts.
      allow create: if signedIn()
        && id.matches('^[A-Za-z0-9_-]{16,40}$')
        && (request.auth.token.firebase.sign_in_provider != 'anonymous' || id.matches('^test-.*'))
        && request.resource.data.keys().hasOnly(
            ['owner', 'status', 'title', 'text', 'performer', 'performerSig', 'performerAt', 'client', 'created', 'version'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.status == 'sent'
        && filled(request.resource.data.title, 120)
        && filled(request.resource.data.text, 20000)
        && filled(request.resource.data.performer, 80)
        && sig(request.resource.data.performerSig)
        && request.resource.data.performerAt == request.time
        && str(request.resource.data.client, 120)
        && request.resource.data.created == request.time
        && request.resource.data.version is int;
      // The client signs once (name, signature, time). Nothing else in the contract can change.
      allow update: if (resource.data.status == 'sent'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'clientName', 'clientSig', 'clientAt'])
          && request.resource.data.status == 'signed'
          && filled(request.resource.data.clientName, 80)
          && sig(request.resource.data.clientSig)
          && request.resource.data.clientAt == request.time)
        // The ShowFee user can cancel a contract that hasn't been signed yet.
        || (signedIn() && resource.data.owner == request.auth.uid && resource.data.status == 'sent'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'void');
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
